{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests"
  ],
  "timezone": "Europe/Berlin",
  "schedule": [
    "* 0-12 * * 1"
  ],
  "labels": [
    "dependencies"
  ],
  "prConcurrentLimit": 5,
  "automergeType": "pr",
  "platformAutomerge": false,
  "internalChecksFilter": "strict",
  "ignoreTests": false,
  "configMigration": true,
  "vulnerabilityAlerts": {
    "labels": [
      "security"
    ]
  },
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [
      "* 0-12 1 * *"
    ]
  },
  "packageRules": [
    {
      "description": "npm: wait 3 days after publish (supply-chain safety; security fixes via vulnerabilityAlerts ignore this)",
      "matchDatasources": [
        "npm"
      ],
      "minimumReleaseAge": "3 days"
    },
    {
      "description": "npm non-major updates in one PR",
      "matchManagers": [
        "npm"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "npm non-major"
    },
    {
      "description": "GitHub Actions: minor/patch/pin/digest in one PR (digest pins kept); majors get their own PR and are never merged automatically",
      "matchManagers": [
        "github-actions"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "digest"
      ],
      "groupName": "github-actions non-major"
    },
    {
      "description": "GitHub Actions: wait 3 days after a new release (pin/digest refreshes of an already used tag are not delayed)",
      "matchManagers": [
        "github-actions"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "minimumReleaseAge": "3 days"
    },
    {
      "description": "Docker image digest refreshes in one PR (NEW in the template: not yet live in a repo; one Node image per repo today, so the group is a no-op there)",
      "matchDatasources": [
        "docker"
      ],
      "matchUpdateTypes": [
        "digest"
      ],
      "groupName": "docker digest"
    },
    {
      "description": "Automerge patch/pin/digest as a PR once ALL checks are green (Renovate itself waits for the checks, ignoreTests=false; no branch protection needed)",
      "matchUpdateTypes": [
        "patch",
        "pin",
        "digest"
      ],
      "automerge": true
    },
    {
      "description": "Automerge minor only for stable (non-0.x) versions; 0.x minors can break and get their own PR for review",
      "matchUpdateTypes": [
        "minor"
      ],
      "matchCurrentVersion": "!/^0/",
      "automerge": true
    },
    {
      "description": "0.x minors: separate PR per package, no automerge",
      "matchUpdateTypes": [
        "minor"
      ],
      "matchCurrentVersion": "/^0/",
      "groupName": "npm 0.x minor",
      "automerge": false
    },
    {
      "description": "Majors never automerge",
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false
    },
    {
      "description": "Node base image: digest/minor only, Node majors are a manual decision (Node 26 line, engines >=26)",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "node"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "enabled": false
    }
  ]
}
