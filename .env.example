# ─── Discord (required) ──────────────────────────────────────────────────────
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=

# ─── HTTP server (incoming webhooks) ─────────────────────────────────────────
HTTP_PORT=3000
HTTP_HOST=0.0.0.0
# Reverse proxies (IPs/CIDRs, or `private` / `none`) whose cf-connecting-ip /
# x-forwarded-for / x-real-ip headers count for rate-limit keys. Checked against
# the socket peer; empty = never trust headers. Replaces TRUST_PROXY (now ignored).
TRUSTED_PROXIES=
# Shared secret required in X-Magguu-Token header on every /webhook/* call.
# Generate with: openssl rand -hex 32   (minimum 16 chars)
WEBHOOK_SECRET=

# GitHub webhook HMAC secret. Set the same value in each repo's
# Settings → Webhooks → Secret. Leave empty to disable /webhook/github.
GITHUB_WEBHOOK_SECRET=
# Bearer-Token für GET /api/status (Home Assistant rest-Sensor); leer = Route aus. openssl rand -hex 32
STATUS_API_TOKEN=

# ─── Sonarr ──────────────────────────────────────────────────────────────────
SONARR_URL=http://sonarr:8989
SONARR_API_KEY=

# ─── Radarr ──────────────────────────────────────────────────────────────────
RADARR_URL=http://radarr:7878
RADARR_API_KEY=

# ─── Seerr (Jellyseerr / Overseerr) ──────────────────────────────────────────
SEERR_URL=http://seerr:5055
SEERR_API_KEY=

# ─── SABnzbd ─────────────────────────────────────────────────────────────────
SAB_URL=http://sabnzbd:8080
SAB_API_KEY=

# ─── Tautulli ────────────────────────────────────────────────────────────────
TAUTULLI_URL=http://tautulli:8181
TAUTULLI_API_KEY=

# Optional TMDB v3 key for poster fallback in Seerr request embeds.
TMDB_API_KEY=

# ─── Runtime ─────────────────────────────────────────────────────────────────
LOG_LEVEL=info
NODE_ENV=production
DATABASE_PATH=./data/bot.db
TIME_ZONE=Europe/Berlin
# 0=Sonntag, 1=Montag, ... 6=Samstag
WEEKLY_DIGEST_ENABLED=true
WEEKLY_DIGEST_DAY=0
WEEKLY_DIGEST_HOUR=10
# Plex-Wochenstatistik-Karte (Tautulli, eine Karte, wird editiert); Standard Montag 08:00
PLEX_WEEKLY_ENABLED=true
PLEX_WEEKLY_DAY=1
PLEX_WEEKLY_HOUR=8
# "Neu hinzugefügt"-Digest (ein Embed mit den Neuzugängen seit dem letzten Digest, Tautulli); Standard Freitag 18:00, nichts Neues = keine Nachricht
PLEX_NEW_DIGEST_ENABLED=true
PLEX_NEW_DIGEST_DAY=5
PLEX_NEW_DIGEST_HOUR=18
# Wöchentliches Embed "FAQ der Woche" (häufigste FAQ-Frage, anonyme Zähler); ohne Nutzung wird nichts gepostet.
FAQ_TOP_ENABLED=true
FAQ_TOP_DAY=1
FAQ_TOP_HOUR=10
# Willkommen-Zähler: eine selbst aktualisierende Nachricht im Willkommen-Kanal (Mitglieder, neu diese Woche), keine Karte pro Beitritt, keine Namen. Ohne Kanal passiert nichts.
WELCOME_COUNTER_ENABLED=true
# Selbst aktualisierende Server-Health-Karte (Mitglieder, aktive Nutzer der Woche, Befehle). Ohne Kanal passiert nichts.
SERVER_HEALTH_CARD_ENABLED=true
# Tägliches SQLite-Backup im Ordner data/backups; nur die neuesten Dateien behalten.
AUTOMATIC_BACKUP_ENABLED=true
AUTOMATIC_BACKUP_HOUR=4
AUTOMATIC_BACKUP_RETENTION=7
# Fehlgeschlagene Webhooks automatisch mit wachsendem Abstand erneut versuchen.
WEBHOOK_RETRY_ENABLED=true
WEBHOOK_RETRY_MAX_ATTEMPTS=5
# Plex-Aktivitätskarten nach N Tagen aus Discord löschen; 0 deaktiviert die Löschung.
PLEX_ACTIVITY_RETENTION_DAYS=7
# Pausierte oder feststeckende Plex-Sessions nach N Minuten über Tautulli beenden; 0 deaktiviert das.
PLEX_STALE_SESSION_MINUTES=20
# Plex-Aktivität: eine Karte pro Plex-User. Optional: Anzeigename-Aliasse (name=alias,... oder JSON) und ausgeblendete User (Komma-Liste).
PLEX_CARD_USER_ALIASES=
PLEX_CARD_USER_EXCLUDE=
# Einmaliges Aufräumen der früheren Plex-Karten (false = Notbremse, DRY_RUN=true zählt nur, SCAN_LIMIT = Scan-Tiefe 100..2000; höher setzen startet einen am Limit beendeten Lauf noch einmal).
PLEX_CARD_CLEANUP_ENABLED=true
PLEX_CARD_CLEANUP_DRY_RUN=false
PLEX_CARD_CLEANUP_SCAN_LIMIT=1000
# /status markiert eine Webhook-Quelle als Warnung, wenn sie länger als N Stunden still ist.
STATUS_STALE_HOURS=24
# /healthz: HTTP 200 mit status "degraded", solange das Discord-Gateway höchstens N Sekunden nicht ready ist
# (Start und kurze Reconnects). Danach 503 (unhealthy). 30-3600, Standard 300. Ein Docker-Healthcheck startet nichts neu.
GATEWAY_GRACE_SECONDS=300

# ─── Engagement ──────────────────────────────────────────────────────────────
# Starboard: how many unique ⭐ reactions trigger a post to #starboard.
STARBOARD_THRESHOLD=3
STARBOARD_EMOJI=⭐
# Automod: delete messages containing Discord invite links (mods bypass).
AUTOMOD_INVITE_FILTER=true

# ─── Dashboard (optional — leave empty to disable admin dashboard) ──────────
# Discord Developer Portal → OAuth2 → Client Secret (reset, then paste).
# Also add your DASHBOARD_BASE_URL/auth/callback to the Redirects list there.
DISCORD_CLIENT_SECRET=
# Random 32+ hex. Signs the HTTP-only session cookie (valid for up to 30 days).
# Keep this value unchanged across updates, otherwise all sessions are invalidated.
# Generate with: openssl rand -hex 32
SESSION_SECRET=
# Comma-separated Discord user IDs allowed to log in.
ADMIN_USER_IDS=
# Public HTTPS origin where the dashboard is reachable (no path/query).
# Used to build the OAuth redirect URI. Must exactly match its origin.
DASHBOARD_BASE_URL=https://your-bot.example.com

# ─── Optional channel-ID overrides ───────────────────────────────────────────
# Normally you DON'T set these. /setup-server writes channel IDs straight
# into SQLite (table channel_config). These env vars are only read as a
# fallback when the DB row is missing — handy for debugging or for forcing
# a specific channel without running the setup command.
#
# DISCORD_CHANNEL_GRABS=
# DISCORD_CHANNEL_IMPORTS=
# DISCORD_CHANNEL_FAILURES=
# DISCORD_CHANNEL_REQUESTS=
# DISCORD_CHANNEL_APPROVALS=
# DISCORD_CHANNEL_NEW_ON_PLEX=
# DISCORD_CHANNEL_HEALTH=
# DISCORD_CHANNEL_WELCOME=
# DISCORD_CHANNEL_AUDIT_LOG=
# DISCORD_CHANNEL_MOD_LOG=
# DISCORD_CHANNEL_GITHUB=
# DISCORD_CHANNEL_STARBOARD=
# DISCORD_CHANNEL_PLEX_ACTIVITY=
# DISCORD_CHANNEL_BLIZZARD=
# DISCORD_CHANNEL_ADDON_UPDATES=
# DISCORD_CHANNEL_FAQ=
# DISCORD_CHANNEL_WEEKLY_DIGEST=
# Optional: eigener Kanal für die Plex-Wochenstatistik (Standard: Wochenrückblick-Kanal)
# DISCORD_CHANNEL_PLEX_WEEKLY=
# Optional: eigener Kanal für den Neu-hinzugefügt-Digest (Standard: New-on-Plex-Kanal, sonst Wochenrückblick)
# DISCORD_CHANNEL_NEW_ADDED=
# Optional: eigener Kanal für "FAQ der Woche" (Standard: Wochenrückblick-Kanal)
# DISCORD_CHANNEL_FAQ_TOP=
# Optional: eigener Kanal für die Server-Health-Karte (Standard: Health-/Status-Kanal; ohne Kanal keine Karte)
# DISCORD_CHANNEL_SERVER_HEALTH=
# DISCORD_CHANNEL_DOWNLOAD_LIVE=
# DISCORD_CHANNEL_MOVIE_NIGHT=
# DISCORD_CHANNEL_SUGGESTIONS=
# DISCORD_CHANNEL_TICKET_LOGS=

# ─── Automod (advanced, all have defaults) ───────────────────────────────────
AUTOMOD_CAPS_FILTER=false
AUTOMOD_CAPS_THRESHOLD=70
AUTOMOD_CAPS_MIN_LEN=10
AUTOMOD_MENTION_SPAM=true
AUTOMOD_MENTION_THRESHOLD=5
AUTOMOD_EXTERNAL_LINK_FILTER=false

# ─── Auto-role ───────────────────────────────────────────────────────────────
# Discord role ID to assign on member join. Defaults to "Newcomer" by name.
# A dashboard selection overrides this value; choosing Standard forces Newcomer.
AUTO_ROLE_ID=

# ─── AI moderation (optional) ────────────────────────────────────────────────
OPENAI_API_KEY=

# ─── WoW Blue Tracker RSS ────────────────────────────────────────────────────
# RSS feed from bluetracker.gg (EU WoW posts only). Correct endpoint as of 2026:
WOW_BLUE_TRACKER_URL=https://www.bluetracker.gg/rss/wow/

# ─── GitHub addon repo routing ───────────────────────────────────────────────
# Comma-separated owner/repo pairs whose releases go to addonUpdates.
# Pushes, workflows, PRs, and issues stay in the private/technical GitHub feed.
ADDON_REPO_FULL_NAMES=Derpsen/MagguuUI
# Read-only GitHub token (contents:read on the private MagguuUI repo). Enables the release poller
# that announces new MagguuUI releases in #addon-updates. Empty = poller off.
MAGGUUUI_READ_TOKEN=
MAGGUUUI_RELEASE_REPO=Derpsen/MagguuUI
# Poll interval in minutes; 0 disables.
ADDON_RELEASE_POLL_MINUTES=15
# Website-FAQ-Autoantwort: kommagetrennte Hilfe-Channel-IDs; leer = aus. Braucht den MessageContent-Intent.
FAQ_AUTOANSWER_CHANNEL_IDS=
WEBSITE_FAQ_API_URL=https://ui.magguu.xyz/api/v1/faqs
WEBSITE_FAQ_PAGE_URL=https://ui.magguu.xyz/faq
FAQ_AUTOANSWER_MIN_SCORE=0.6
FAQ_AUTOANSWER_USER_COOLDOWN_SECONDS=300
FAQ_AUTOANSWER_CHANNEL_COOLDOWN_SECONDS=60
FAQ_AUTOANSWER_REPEAT_WINDOW_MINUTES=360

# Raider.IO score roles (/rio-link, /rio-unlink; on request only, no OAuth, no background sync).
# Thresholds: JSON [{"minScore":2000,"roleId":"..."}] or short form "2000=roleId,2500=roleId". Empty = feature off (the commands say so).
# The roles must already exist, be plain display roles WITHOUT moderation/admin permissions (the bot refuses others, also at startup); the bot needs Manage Roles and its own role above them. /rio-config (Manage Server) can override these at runtime.
RIO_ROLE_THRESHOLDS=
RIO_SEASON_LABEL=

# Read-only report of big unseen / long-unwatched Plex media for the Magguu dashboard (admin card via GET /api/status).
# Needs TAUTULLI_URL + TAUTULLI_API_KEY (read-only calls get_libraries / get_library_media_info), computed at most once per 24 h, nothing is ever deleted.
PLEX_UNSEEN_REPORT_ENABLED=true
PLEX_UNSEEN_REPORT_MIN_AGE_DAYS=90
PLEX_UNSEEN_REPORT_STALE_DAYS=365
