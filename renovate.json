{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "timezone": "Europe/Berlin",
  "schedule": [
    "* 0-12 * * 1"
  ],
  "labels": [
    "dependencies"
  ],
  "prConcurrentLimit": 5,
  "platformAutomerge": true,
  "ignoreTests": false,
  "configMigration": true,
  "vulnerabilityAlerts": {
    "labels": [
      "security"
    ]
  },
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [
      "* 0-12 1 * *"
    ]
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Dockerfile base image digest (ARG NODE_DIGEST, FROM uses variables)",
      "fileMatch": [
        "(^|/)Dockerfile$"
      ],
      "matchStrings": [
        "#\\s*renovate: image=(?<depName>[^:\\s]+):(?<currentValue>\\S+)\\nARG NODE_VERSION=\\S+\\nARG NODE_DIGEST=(?<currentDigest>sha256:[a-f0-9]{64})"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    }
  ],
  "packageRules": [
    {
      "description": "npm: wait 3 days after publish (supply-chain safety; security fixes via vulnerabilityAlerts ignore this)",
      "matchDatasources": [
        "npm"
      ],
      "minimumReleaseAge": "3 days"
    },
    {
      "description": "npm non-major updates in one PR",
      "matchManagers": [
        "npm"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "npm non-major"
    },
    {
      "description": "GitHub Actions in one PR (digest pins kept)",
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "github-actions"
    },
    {
      "description": "Automerge minor/patch/pin/digest only after green required status checks; lands directly on main (branch automerge)",
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "digest"
      ],
      "automerge": true,
      "automergeType": "branch"
    },
    {
      "description": "Majors never automerge",
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false
    },
    {
      "description": "@types/node stays 24.x",
      "matchPackageNames": [
        "@types/node"
      ],
      "allowedVersions": "<25"
    },
    {
      "description": "TypeScript 7 locked",
      "matchPackageNames": [
        "typescript"
      ],
      "allowedVersions": "<7"
    },
    {
      "description": "h3 2 locked",
      "matchPackageNames": [
        "h3"
      ],
      "allowedVersions": "<2"
    },
    {
      "description": "satori pinned to 0.41",
      "matchPackageNames": [
        "satori"
      ],
      "allowedVersions": "~0.41.0"
    },
    {
      "description": "undici 8 blocked: only used as npm override for discord.js/@discordjs/rest 14.27/2.6.3 (declare undici ^6.27) and cheerio 1.2 (^7.19); 8.x is outside their ranges and the PR #112 lockfile was broken. Re-check when discord.js/cheerio support undici 8.",
      "matchPackageNames": [
        "undici"
      ],
      "allowedVersions": "<8"
    },
    {
      "description": "undici majors off: each override must stay in its parent's declared major (6 for discord.js, 7 for cheerio)",
      "matchPackageNames": [
        "undici"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "enabled": false
    },
    {
      "description": "Node base image: digest/minor only, Node majors are a manual decision (engines >=26, Node 26 locked line)",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "node"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "enabled": false
    }
  ]
}
