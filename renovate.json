{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests"
  ],
  "timezone": "Europe/Berlin",
  "schedule": [
    "* 0-12 * * 1"
  ],
  "labels": [
    "dependencies"
  ],
  "prConcurrentLimit": 5,
  "automergeType": "pr",
  "platformAutomerge": false,
  "internalChecksFilter": "strict",
  "ignoreTests": false,
  "configMigration": true,
  "vulnerabilityAlerts": {
    "labels": [
      "security"
    ]
  },
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [
      "* 0-12 1 * *"
    ]
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Dockerfile base image digest (ARG NODE_DIGEST, FROM uses variables)",
      "matchStrings": [
        "#\\s*renovate: image=(?<depName>[^:\\s]+):(?<currentValue>\\S+)\\nARG NODE_VERSION=\\S+\\nARG NODE_DIGEST=(?<currentDigest>sha256:[a-f0-9]{64})"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker",
      "managerFilePatterns": [
        "/(^|/)Dockerfile$/"
      ]
    }
  ],
  "packageRules": [
    {
      "description": "npm: wait 3 days after publish (supply-chain safety; security fixes via vulnerabilityAlerts ignore this)",
      "matchDatasources": [
        "npm"
      ],
      "minimumReleaseAge": "3 days"
    },
    {
      "description": "npm non-major updates in one PR",
      "matchManagers": [
        "npm"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "npm non-major"
    },
    {
      "description": "GitHub Actions: minor/patch/pin/digest in one PR (digest pins kept); majors get their own PR and are never merged automatically",
      "matchManagers": [
        "github-actions"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "digest"
      ],
      "groupName": "github-actions non-major"
    },
    {
      "description": "GitHub Actions: wait 3 days after a new release (pin/digest refreshes of an already used tag are not delayed)",
      "matchManagers": [
        "github-actions"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "minimumReleaseAge": "3 days"
    },
    {
      "description": "Automerge patch/pin/digest as a PR once ALL checks are green (Renovate itself waits for the checks, ignoreTests=false; no branch protection needed)",
      "matchUpdateTypes": [
        "patch",
        "pin",
        "digest"
      ],
      "automerge": true
    },
    {
      "description": "Automerge minor only for stable (non-0.x) versions; 0.x minors can break and get their own PR for review",
      "matchUpdateTypes": [
        "minor"
      ],
      "matchCurrentVersion": "!/^0/",
      "automerge": true
    },
    {
      "description": "0.x minors: separate PR per package, no automerge",
      "matchUpdateTypes": [
        "minor"
      ],
      "matchCurrentVersion": "/^0/",
      "groupName": "npm 0.x minor",
      "automerge": false
    },
    {
      "description": "Majors never automerge",
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false
    },
    {
      "description": "@types/node stays 24.x",
      "matchPackageNames": [
        "@types/node"
      ],
      "allowedVersions": "<25"
    },
    {
      "description": "TypeScript 7 locked",
      "matchPackageNames": [
        "typescript"
      ],
      "allowedVersions": "<7"
    },
    {
      "description": "h3 2 locked (stay on 1.x)",
      "matchPackageNames": [
        "h3"
      ],
      "allowedVersions": "<2"
    },
    {
      "description": "satori >=0.48 locked (repo family uses 0.47.x); stays below 0.48",
      "matchPackageNames": [
        "satori"
      ],
      "allowedVersions": "<0.48"
    },
    {
      "description": "undici 8 blocked: only used as npm override for discord.js/@discordjs/rest 14.27/2.6.3 (declare undici ^6.27) and cheerio 1.2 (^7.19); 8.x is outside their ranges and the PR #112 lockfile was broken. Re-check when discord.js/cheerio support undici 8.",
      "matchPackageNames": [
        "undici"
      ],
      "allowedVersions": "<8"
    },
    {
      "description": "undici majors off: each override must stay in its parent's declared major (6 for discord.js, 7 for cheerio)",
      "matchPackageNames": [
        "undici"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "enabled": false
    },
    {
      "description": "Node base image: digest/minor only, Node majors are a manual decision (engines >=26, Node 26 locked line)",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "node"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "enabled": false
    }
  ]
}
