{
  "name": "magguu-bot",
  "version": "0.1.0",
  "private": true,
  "description": "Discord bot + admin dashboard for a media homelab (Sonarr, Radarr, Seerr, Tautulli, SABnzbd).",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:frontend": "vite",
    "build": "npm run build:frontend && tsc",
    "build:frontend": "vite build",
    "build:backend": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit && vue-tsc --noEmit -p frontend/tsconfig.json",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "@napi-rs/canvas": "^0.1.100",
    "better-sqlite3": "^11.7.0",
    "cheerio": "^1.2.0",
    "discord.js": "^14.26.4",
    "drizzle-orm": "^0.45.2",
    "fast-xml-parser": "^5.7.2",
    "hono": "^4.12.16",
    "pino": "^9.5.0",
    "pino-pretty": "^11.3.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^25.7.0",
    "@vitejs/plugin-vue": "^6.0.6",
    "autoprefixer": "^10.4.20",
    "drizzle-kit": "^0.31.10",
    "lucide-vue-next": "^1.0.0",
    "postcss": "^8.5.14",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.19.2",
    "typescript": "^6.0.3",
    "vite": "^8.0.12",
    "vue": "^3.5.34",
    "vue-router": "^5.0.6",
    "vue-tsc": "^3.2.8"
  }
}
