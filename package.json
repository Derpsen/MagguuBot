{
  "name": "magguu-bot",
  "version": "0.1.0",
  "private": true,
  "description": "Discord bot + admin dashboard for a media homelab (Sonarr, Radarr, Seerr, Tautulli, SABnzbd).",
  "type": "module",
  "engines": {
    "node": ">=24.17.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:frontend": "vite",
    "build": "npm run build:frontend && tsc",
    "build:frontend": "vite build",
    "build:backend": "tsc",
    "start": "node dist/index.js",
    "check": "npm run typecheck && npm test && npm run build",
    "test": "node --import tsx --test tests/maintenance.test.ts tests/seerr-webhook.test.ts tests/features.test.ts",
    "security:audit": "npm audit",
    "deps:outdated": "npm outdated",
    "typecheck": "tsc --noEmit && vue-tsc --noEmit -p frontend/tsconfig.json",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.8",
    "@napi-rs/canvas": "^1.0.1",
    "better-sqlite3": "^12.11.1",
    "cheerio": "^1.2.0",
    "discord.js": "^14.26.4",
    "drizzle-orm": "^0.45.2",
    "fast-xml-parser": "^5.9.3",
    "hono": "^4.12.28",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@lucide/vue": "^1.22.0",
    "@tailwindcss/postcss": "^4.3.1",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^26.1.1",
    "@vitejs/plugin-vue": "^6.0.6",
    "autoprefixer": "^10.4.20",
    "drizzle-kit": "^0.31.10",
    "postcss": "^8.5.14",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.19.2",
    "typescript": "^7.0.2",
    "vite": "^8.0.16",
    "vue": "^3.5.38",
    "vue-router": "^5.0.7",
    "vue-tsc": "^3.3.5"
  },
  "overrides": {
    "esbuild": "0.28.1",
    "discord.js": {
      "undici": "6.27.0"
    },
    "@discordjs/rest": {
      "undici": "6.27.0"
    }
  }
}
